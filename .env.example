# Copier en .env pour surcharger les valeurs par défaut de docker-compose.yml.


# Linux uniquement : `echo "AIRFLOW_UID=$(id -u)" >> .env` évite les soucis de droits
AIRFLOW_UID=
AIRFLOW_ADMIN_USER=
AIRFLOW_ADMIN_PASSWORD=

MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
DATALAKE_BUCKET=

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_PORT=
WAREHOUSE_USER=
WAREHOUSE_PASSWORD=

#token gratuit (https://data.cityofchicago.org/profile/edit/developer_settings)
SODA_APP_TOKEN=
SODA_MAX_WORKERS=4

# Période traitée (un run Airflow par mois)
PIPELINE_START_DATE=2023-01-01
PIPELINE_END_DATE=2023-03-31

MAX_REJECTED_RATIO=0.05
SPARK_DRIVER_MEMORY=2g
