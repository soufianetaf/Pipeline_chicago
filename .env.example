# Copier en .env pour surcharger les valeurs par défaut de docker-compose.yml.
# Identifiants de développement local uniquement : ne jamais y mettre de vrais secrets.

# Linux uniquement : `echo "AIRFLOW_UID=$(id -u)" >> .env` évite les soucis de droits
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=airflow

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
DATALAKE_BUCKET=datalake

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow
POSTGRES_PORT=5432
WAREHOUSE_USER=analytics
WAREHOUSE_PASSWORD=analytics

# Optionnel : token gratuit (https://data.cityofchicago.org/profile/edit/developer_settings)
# qui relève les quotas de l'API SODA.
SODA_APP_TOKEN=
SODA_MAX_WORKERS=4

# Période traitée (un run Airflow par mois)
PIPELINE_START_DATE=2023-01-01
PIPELINE_END_DATE=2023-03-31

MAX_REJECTED_RATIO=0.05
SPARK_DRIVER_MEMORY=2g
